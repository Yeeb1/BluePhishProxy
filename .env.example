# ============================================================
# BluePhishProxy v3.0 — Environment Configuration
# ============================================================
# Copy this file to .env and customise for your engagement.

# --- Server ---
BPP_HOST=0.0.0.0
BPP_PORT=8443
BPP_DEBUG=false
BPP_TRUSTED_PROXIES=1

# --- Campaign defaults ---
BPP_SAFE_REDIRECT_URL=https://www.microsoft.com/en-us/security
BPP_FLAGGED_REDIRECT_URL=https://www.microsoft.com/en-us/security
BPP_BRAND=Microsoft
BPP_DEFAULT_TEMPLATE=safelinks

# --- Single-campaign auto-setup (set to auto-create on boot) ---
# BPP_CAMPAIGN_NAME=Q4 Engagement
# BPP_CAMPAIGN_TEMPLATE=safelinks

# --- Detection tuning ---
BPP_BOT_THRESHOLD=50
BPP_SUSPICIOUS_THRESHOLD=25

# --- IP enrichment ---
BPP_IP_ENRICHMENT=true
# BPP_IPINFO_TOKEN=your_ipinfo_token
BPP_IPINFO_TIMEOUT=3.0

# --- Database ---
BPP_DATABASE=data/bluephishproxy.db

# --- Authentication ---
# Legacy operator token (still supported, API keys preferred)
# BPP_OPERATOR_TOKEN=your_operator_token_here
BPP_RATE_LIMIT=60

# --- Session ---
# BPP_SECRET_KEY=generate-a-strong-random-key-here
BPP_SESSION_MAX_AGE=3600

# --- TLS (direct, without Cloudflare) ---
# BPP_TLS_CERT=certs/fullchain.pem
# BPP_TLS_KEY=certs/privkey.pem

# --- Cloudflare ---
BPP_BEHIND_CLOUDFLARE=false

# --- Webhooks (JSON array of URLs or webhook configs) ---
# BPP_WEBHOOK_URLS=["https://hooks.slack.com/services/xxx"]
BPP_WEBHOOK_MIN_LEVEL=suspicious

# --- Custom templates (drop .html files here to extend built-in lures) ---
# BPP_TEMPLATES_DIR=/path/to/custom/templates

# --- Redirect chains (JSON, per-classification) ---
# BPP_REDIRECT_CHAINS={"bot":[{"url":"https://decoy.example.com","delay_ms":2000},{"url":"https://block.example.com","delay_ms":1000}],"clean":[{"url":"https://target.example.com","delay_ms":0}]}

# --- Cloudflare Tunnel (prod compose only) ---
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token
